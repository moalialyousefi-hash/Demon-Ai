require('dotenv').config();
const { Client, GatewayIntentBits, REST, Routes, SlashCommandBuilder } = require('discord.js');
const puppeteer = require('puppeteer');
const { GoogleGenAI } = require('@google/genai');

const ai = new GoogleGenAI({ apiKey: process.env.GEMINI_API_KEY });
const client = new Client({ intents: [GatewayIntentBits.Guilds] });

// Register /autocomplete command
const commands = [
  new SlashCommandBuilder()
    .setName('autocomplete')
    .setDescription('Log into Sparx and auto-complete homework tasks')
    .addStringOption(opt => opt.setName('school').setDescription('School name').setRequired(true))
    .addStringOption(opt => opt.setName('username').setDescription('Sparx username').setRequired(true))
    .addStringOption(opt => opt.setName('password').setDescription('Sparx password').setRequired(true))
    .addIntegerOption(opt => opt.setName('questions').setDescription('Number of questions to solve (max 10)').setRequired(true))
].map(cmd => cmd.toJSON());

const rest = new REST({ version: '10' }).setToken(process.env.DISCORD_TOKEN);
(async () => {
  await rest.put(Routes.applicationCommands(process.env.CLIENT_ID), { body: commands });
})();

client.on('interactionCreate', async interaction => {
  if (!interaction.isChatInputCommand() || interaction.commandName !== 'autocomplete') return;

  await interaction.deferReply({ ephemeral: true });

  const school = interaction.options.getString('school');
  const username = interaction.options.getString('username');
  const password = interaction.options.getString('password');
  const maxQuestions = Math.min(interaction.options.getInteger('questions'), 10);

  let browser;
  const bookworkLog = {}; // Stores Bookwork Code -> Answer

  try {
    // Must be 'new' or true when running in GitHub Codespaces / Cloud
    browser = await puppeteer.launch({
      headless: 'new',
      args: ['--no-sandbox', '--disable-setuid-sandbox']
    });
    const page = await browser.newPage();

    // 1. Log into Sparx
    await page.goto('https://sparxmaths.uk', { waitUntil: 'networkidle2' });
    await page.type('input[placeholder*="school"]', school);
    await page.keyboard.press('Enter');
    await page.waitForSelector('input[name="username"]', { timeout: 10000 });

    await page.type('input[name="username"]', username);
    await page.type('input[name="password"]', password);
    await page.click('button[type="submit"]');
    await page.waitForNavigation({ waitUntil: 'networkidle2' });

    // 2. Click into the first active homework task (Update selector from your GitHub solver)
    await page.waitForSelector('a[href*="/task/"]', { timeout: 10000 });
    await page.click('a[href*="/task/"]');

    let solvedCount = 0;

    // 3. Loop through questions
    for (let i = 0; i < maxQuestions; i++) {
      await new Promise(r => setTimeout(r, 2500)); // Wait for question to render

      // Check if a Bookwork Check popped up
      const isBookworkCheck = await page.evaluate(() => {
        return document.body.innerText.includes('Bookwork check');
      });

      if (isBookworkCheck) {
        const codeNeeded = await page.evaluate(() => {
          const match = document.body.innerText.match(/Bookwork code:\s*([A-Z0-9]+)/i);
          return match ? match[1] : null;
        });

        if (codeNeeded && bookworkLog[codeNeeded]) {
          // Click the matching saved answer option
          await page.evaluate((savedAns) => {
            const buttons = Array.from(document.querySelectorAll('button'));
            const target = buttons.find(b => b.innerText.includes(savedAns));
            if (target) target.click();
          }, bookworkLog[codeNeeded]);
          continue;
        }
      }

      // Capture screenshot of question (handles diagrams, fractions, and graphs)
      const screenshotBase64 = await page.screenshot({ encoding: 'base64' });

      // Grab current bookwork code
      const currentCode = await page.evaluate(() => {
        const match = document.body.innerText.match(/Bookwork code:\s*([A-Z0-9]+)/i);
        return match ? match[1] : null;
      });

      // Ask Gemini Vision for the exact input value only
      const response = await ai.models.generateContent({
        model: 'gemini-2.5-flash',
        contents: [
          { inlineData: { data: screenshotBase64, mimeType: 'image/png' } },
          'Solve this Sparx Maths question. Reply with ONLY the exact final number, expression, or option text to type into the answer box. No explanations, no units unless asked.'
        ]
      });

      const answer = response.text.trim();
      if (currentCode) bookworkLog[currentCode] = answer;

      // Type answer into the Sparx input box & submit
      const inputSelector = 'input[type="text"], input[type="number"]';
      if (await page.$(inputSelector)) {
        await page.click(inputSelector, { clickCount: 3 });
        await page.type(inputSelector, answer);
        await page.keyboard.press('Enter');
        solvedCount++;
      } else {
        // Multiple choice click fallback
        await page.evaluate((ans) => {
          const options = Array.from(document.querySelectorAll('button, [role="button"]'));
          const match = options.find(el => el.innerText.trim() === ans);
          if (match) match.click();
        }, answer);
        solvedCount++;
      }

      // Click "Next" / "Summary" if present
      await new Promise(r => setTimeout(r, 1500));
      await page.evaluate(() => {
        const nextBtn = Array.from(document.querySelectorAll('button')).find(b =>
          b.innerText.includes('Next') || b.innerText.includes('Continue')
        );
        if (nextBtn) nextBtn.click();
      });
    }

    await interaction.editReply(`Finished! Attempted **${solvedCount}** questions.`);

  } catch (error) {
    console.error(error);
    await interaction.editReply(`Stopped early due to an error or custom question format: \`${error.message}\``);
  } finally {
    if (browser) await browser.close();
  }
});

client.login(process.env.DISCORD_TOKEN);

